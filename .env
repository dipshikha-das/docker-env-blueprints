# Set and export the container and image names; is loaded in the docker-compose.yaml
export CONTAINER_NAME=ros_noetic_base_dummy #UserDefined: Set the container name
export IMAGE_NAME=ros_noetic_base_dummy:v0.0 #UserDefined: Set the image name
export HOST_HOME="/home/myuser" #UserDefined: Set the host home from where files can be loaded; @NOTE no / required in the end
export LOCAL_WORKSPACE="mytestworkspace/src" #UserDefined: Current workspace directory; @NOTE no / required in the beginning


# UserDefined: Add required dependencies and packages with spaces(delimiter)
export APT_PACKAGES="terminator python3 python3-pip python3-colcon-common-extensions python3-catkin-tools build-essential python3-rosdep python3.8-venv libboost-all-dev libnlopt-dev libnlopt-cxx-dev swig net-tools mlocate"
# export APT_PACKAGES="ros-humble-rmw-cyclonedds-cpp python3-pip terminator build-essential libboost-all-dev libnlopt-dev libnlopt-cxx-dev swig net-tools"

# UserDefined: All python dependent install should be defined in the requirements.txt file
export PACKAGE_REQUIREMENTS_PATHS="/deps/requirements.txt"

# UserDefined: Define the ros version to make custom changes to bash accordingly (options are 1 and 2 currently)
export ROS_IMAGE_VERSION=1

# UserDefined: For ros1 hostname setup or ros2 cyclonedds peer setup
export HOST_IP_ADD="192.168.0.1"
